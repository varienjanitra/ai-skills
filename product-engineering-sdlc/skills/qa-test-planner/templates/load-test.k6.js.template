import http from 'k6/http';
import { check, sleep } from 'k6';

/**
 * [k6 Performance & Load Benchmark Script] {Feature Name}
 * Validates throughput, latency SLOs, and error rate ceilings under peak traffic.
 * Reference: docs/qa/{feature-name}-test-plan.md
 *
 * To run:
 *   k6 run tests/perf/{feature-name}.load.js
 */

export const options = {
  stages: [
    { duration: '1m', target: 200 },   // Warm-up ramp
    { duration: '3m', target: 1000 },  // Peak sustained traffic
    { duration: '1m', target: 1500 },  // Stress spike
    { duration: '1m', target: 0 },     // Ramp-down
  ],
  thresholds: {
    // SLO: 95% of requests must complete below 200ms
    http_req_duration: ['p(95)<200', 'p(99)<450'],
    // SLO: Error rate must stay below 0.1%
    http_req_failed: ['rate<0.001'],
  },
};

const BASE_URL = __ENV.API_BASE_URL || 'http://localhost:3000';
const AUTH_TOKEN = __ENV.TEST_AUTH_TOKEN || 'Bearer mock-jwt-token';

export default function () {
  const params = {
    headers: {
      'Content-Type': 'application/json',
      'Authorization': AUTH_TOKEN,
      'Idempotency-Key': `k6-${__VU}-${__ITER}-${Date.now()}`,
    },
  };

  // Test primary query / read path
  const res = http.get(`${BASE_URL}/api/v1/{resource}`, params);

  check(res, {
    'status is 200': (r) => r.status === 200,
    'response has data array': (r) => JSON.parse(r.body).data !== undefined,
  });

  sleep(1);
}
