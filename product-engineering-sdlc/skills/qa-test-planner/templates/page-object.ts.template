import { type Page, type Locator, expect } from '@playwright/test';

/**
 * [Page Object Model] {Feature / Page Name}
 * Encapsulates selectors, locators, and UI interactions according to WCAG a11y standards.
 * Reference: docs/design/{feature-name}-design-spec.md
 */
export class {Feature}Page {
  readonly page: Page;
  readonly pageHeading: Locator;
  readonly searchInput: Locator;
  readonly createButton: Locator;
  readonly dataTable: Locator;
  readonly emptyStateContainer: Locator;
  readonly errorBanner: Locator;
  readonly submitDrawer: Locator;
  readonly nameInput: Locator;
  readonly saveButton: Locator;

  constructor(page: Page) {
    this.page = page;
    // Resilient, accessible selectors matching design spec
    this.pageHeading = page.getByRole('heading', { name: /{Feature Name}/i });
    this.searchInput = page.getByPlaceholder(/search resources/i);
    this.createButton = page.getByRole('button', { name: /\+ create/i });
    this.dataTable = page.getByRole('table');
    this.emptyStateContainer = page.getByTestId('empty-state');
    this.errorBanner = page.getByRole('alert');
    this.submitDrawer = page.getByRole('dialog');
    this.nameInput = page.getByLabel(/name \*/i);
    this.saveButton = page.getByRole('button', { name: /^create$/i });
  }

  async goto() {
    await this.page.goto('/{feature-route}');
    await expect(this.pageHeading).toBeVisible();
  }

  async openCreateDrawer() {
    await this.createButton.click();
    await expect(this.submitDrawer).toBeVisible();
  }

  async fillResourceForm(name: string, description?: string) {
    await this.nameInput.fill(name);
    if (description) {
      await this.page.getByLabel(/description/i).fill(description);
    }
  }

  async submitForm() {
    await this.saveButton.click();
  }

  async search(query: string) {
    await this.searchInput.fill(query);
    await this.page.keyboard.press('Enter');
  }
}
